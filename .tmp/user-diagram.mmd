flowchart TD
    classDef extract fill:#e8f5e9,stroke:#2e7d32,stroke-width:2px
    classDef noop fill:#fff3e0,stroke:#ef6c00,stroke-width:2px
    classDef decision fill:#e3f2fd,stroke:#1565c0,stroke-width:2px
    classDef error fill:#ffebee,stroke:#c62828,stroke-width:2px
    classDef filter fill:#f3e5f5,stroke:#6a1b9a,stroke-width:2px

    subgraph IN["Вход: ProfileEvent"]
        IN1["ProfileActual.characteristic (список)<br/>ProfileChange.characteristic (список)"]
    end

    subgraph EXTRACT["1. Извлечение характеристик"]
        direction TB
        EC_C["ProfileChange"]
        EC_C --> EC_CL["LastIMEI<br/>→ changeLast, hasChangeLast"]
        EC_C --> EC_CA["AllowedIMEI<br/>→ changeAllowed, hasChangeAllowed"]
        EC_A["ProfileActual"]
        EC_A --> EC_AL["LastIMEI<br/>→ actualLast, hasActualLast"]
        EC_A --> EC_AA["AllowedIMEI<br/>→ actualAllowed, hasActualAllowed"]
        EC_A --> EC_AC["CoolingNewIMEI<br/>→ проверка на дубликат<br/>(только для резидентов)"]
        EC_CA --> EC_CAL["changeAllowedList =<br/>scalarListFromCharacteristic<br/>(changeAllowed, hasChangeAllowed)"]
        EC_AA --> EC_AAL["actualAllowedList =<br/>scalarListFromCharacteristic<br/>(actualAllowed, hasActualAllowed)<br/>⚠️ has=false → nil, не пустой список"]
    end

    subgraph FILTER["2. Фильтр «взять в работу»"]
        F1{"hasChangeLast<br/>или hasChangeAllowed<br/>или len(actualAllowedList) > 0 ?"}
        F_NO["🚫 NOOP<br/>Evaluation{}"]
    end

    subgraph LAST["3. Определение lastIMEI"]
        L1{"hasChangeLast<br/>и scalarText(changeLast.Value) != '' ?"}
        L1_YES["lastIMEI =<br/>changeLast.Value"]
        L1_NO{"hasActualLast ?"}
        L1_NO_YES["lastIMEI =<br/>actualLast.Value<br/>(может быть пустым)"]
        L1_NO_NO["lastIMEI = ''"]
    end

    subgraph ALLOWED["4. Определение allowed"]
        A1{"hasChangeAllowed ?"}
        A1_YES["allowed =<br/>changeAllowedList"]
        A1_NO["allowed =<br/>actualAllowedList"]
    end

    subgraph IMEI_OFF["5. IMEIControl отключён"]
        IO1{"hasChangeAllowed<br/>и len(allowed) == 0 ?"}
        IO_DESC["change явно передал<br/>AllowedIMEI = пустой список<br/>а actual был непустым"]
        IO_YES["✅ Decision:<br/>CheckResults[<br/>  {Code: IsIMEIMismatch, Value: '0'},<br/>  {Code: LastIMEI, Value: lastIMEI}<br/>]<br/>NonResidentControl: true"]
    end

    subgraph NONRES["6. Ветка НЕРЕЗИДЕНТ"]
        NR1{"len(allowed) > 0<br/>или imeiControlDisabled ?"}
        NR2{"isControllingIMEI ?"}
        NR2_NO["🚫 NOOP"]
        NR3{"lastIMEI == '' ?"}
        NR3_YES["NonResidentControl: true<br/>Decision = nil<br/>(контроль засчитан,<br/>событие не эмитится)"]
        NR4["value = '1'"]
        NR5{"imeiControlDisabled<br/>или contains(allowed, lastIMEI) ?"}
        NR5_YES["value = '0'"]
        NR_DEC["✅ Decision:<br/>CheckResults[<br/>  {Code: IsIMEIMismatch, Value: value},<br/>  {Code: LastIMEI, Value: lastIMEI}<br/>]<br/>NonResidentControl: true"]
    end

    subgraph RES["7. Ветка РЕЗИДЕНТ"]
        R1{"AllowedIMEI пуст/отсутствует<br/>в обоих профилях"}
        R2{"isCoolingNewIMEI ?"}
        R2_NO["🚫 NOOP"]
        R3{"lastIMEI == '' ?"}
        R3_YES["🚫 NOOP<br/>(контроль НЕ засчитан)"]
        R4["Проверка дубликата<br/>CoolingNewIMEI в actual"]
        R4_ERR["❌ error:<br/>дубликат CoolingNewIMEI"]
        R_DEC["✅ Decision:<br/>CheckResults[<br/>  {Code: IsCoolingNewIMEI, Value: '1'},<br/>  {Code: LastIMEI, Value: lastIMEI}<br/>]<br/>ResidentControl: true"]
    end

    subgraph BD["8. buildDecision (для всех ✅ Decision)"]
        BD1["checkedAt =<br/>ProfileChange.ValidFor.StartTime<br/>(обязательно, RFC3339Nano)"]
        BD2["telcoProfileID = resolveTelcoProfileID()<br/>1. ProfileActual.ID<br/>2. Source.Reference.ID<br/>3. Source.ID<br/>4. event.Key"]
        BD3["Decision{<br/>  CheckedAt,<br/>  TelcoProfileID,<br/>  CheckResults<br/>}"]
    end

    subgraph POST["9. Пост-обработка (processor)"]
        P_TYPE["Тип события по CheckResults[0].Code:"]
        P_M["IsIMEIMismatch →<br/>SourceType: 'ImeiMismatch'<br/>Consumer: mismatchConsumer"]
        P_C["IsCoolingNewIMEI →<br/>SourceType: 'CoolingNewImei'<br/>Consumer: coolingConsumer"]
        P_FILT{"isCoolingFiltered()<br/>только для Cooling:<br/>IMSI из ProfileActual<br/>→ settings.AllowCoolingNewIMEI(imsi)<br/>'*' = все, иначе фильтр"}
        P_FILT_YES["🚫 cooling_filtered"]
    end

    subgraph OUT["Выход"]
        O_EVT["📤 Kafka: sag-control-imeimismatch<br/>StartRegulatoryOrderEvent"]
        O_NO["🚫 NOOP (nil)"]
    end

    IN --> EXTRACT
    EXTRACT --> FILTER
    FILTER --> F1
    F1 -->|нет| F_NO
    F1 -->|да| LAST

    LAST --> L1
    L1 -->|да| L1_YES
    L1 -->|нет| L1_NO
    L1_NO -->|да| L1_NO_YES
    L1_NO -->|нет| L1_NO_NO
    L1_YES --> ALLOWED
    L1_NO_YES --> ALLOWED
    L1_NO_NO --> ALLOWED

    ALLOWED --> A1
    A1 -->|да| A1_YES
    A1 -->|нет| A1_NO
    A1_YES --> IMEI_OFF
    A1_NO --> IMEI_OFF

    IMEI_OFF --> IO1
    IO1 -->|да| IO_YES
    IO1 -->|нет| NR1

    IO_YES --> BD

    NR1 -->|да| NR2
    NR1 -->|нет| R1
    NR2 -->|нет| NR2_NO
    NR2 -->|да| NR3
    NR3 -->|да| NR3_YES
    NR3 -->|нет| NR4
    NR4 --> NR5
    NR5 -->|да| NR5_YES
    NR5 -->|нет| NR_DEC
    NR5_YES --> NR_DEC
    NR_DEC --> BD

    R1 --> R2
    R2 -->|нет| R2_NO
    R2 -->|да| R3
    R3 -->|да| R3_YES
    R3 -->|нет| R4
    R4 -->|error| R4_ERR
    R4 -->|ok| R_DEC
    R_DEC --> BD

    BD --> P_TYPE
    P_TYPE --> P_M
    P_TYPE --> P_C
    P_C --> P_FILT
    P_FILT -->|да| P_FILT_YES
    P_FILT -->|нет| O_EVT
    P_M --> O_EVT

    F_NO --> O_NO
    NR2_NO --> O_NO
    NR3_YES --> O_NO
    R2_NO --> O_NO
    R3_YES --> O_NO
    P_FILT_YES --> O_NO

    class EXTRACT,EC_C,EC_A,EC_CL,EC_CA,EC_AL,EC_AA,EC_AC,EC_CAL,EC_AAL extract
    class F_NO,NR2_NO,NR3_YES,R2_NO,R3_YES,P_FILT_YES,O_NO noop
    class IO_YES,NR_DEC,R_DEC,BD3 decision
    class R4_ERR error
    class F1,L1,L1_NO,A1,IO1,NR1,NR2,NR3,NR5,R2,R3,P_FILT filter
